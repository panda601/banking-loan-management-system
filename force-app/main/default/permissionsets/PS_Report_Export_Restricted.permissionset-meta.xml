<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Restricted permission set allowing authorized users to export report data to CSV/Excel.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Report Export Restricted</label>
    <userPermissions>
        <enabled>true</enabled>
        <name>RunReports</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ExportReport</name>
    </userPermissions>
</PermissionSet>
